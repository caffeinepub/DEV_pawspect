                                   ok;
                                 });
  approveSitterApplication: (sitterId: Id) -> (variant {
                                                 err: text;
                                                 ok;
                                               });
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  assignCoSitters: (bookingId: nat, teamId: text, assignmentsList:
   vec record {
         nat;
         text;
       }) -> (variant {
                err: text;
                ok: CoBookingAssignment;
              });
  assignDuty: (threadId: text, assignedSitterId: nat, description: text,
   taskLabels: vec text) -> (variant {
                               err: text;
                               ok: DutyAssignment;
                             });
  assignSitterToFreePlan: (sitterId: Id) -> (variant {
                                               err: text;
                                               ok;
                                             });
  backfillSitterHandles: () -> (variant {
                                  err: text;
                                  ok: nat;
                                });
  cancelBookingByClient: (bookingId: Id, cancelReason: text) ->
   (variant {
      err: text;
      ok;
    });
  cancelRecurringGroup: (groupId: text, cancelledBy: text) ->
   (variant {
      err: text;
      ok;
    });
  cancelSubscription: (sitterId: nat) -> (variant {
                                            err: text;
                                            ok;
                                          });
  checkAndSendTrialReminder: () -> (variant {
                                      err: text;
                                      ok: text;
                                    });
  checkSittersAvailabilityForRebook: (sitterIds: vec nat, dates: vec text,
   services: vec text) ->
   (vec record {
          available: bool;
          reason: text;
          sitterId: nat;
        }) query;
  claimFirstAdmin: () -> (bool);
  clearAllData: () -> (variant {
                         err: text;
                         ok;
                       });
  confirmManualPayment: (bookingId: Id) -> ();
  confirmManualPaymentWithEmail: (bookingId: Id, paidDate: text) ->
   (variant {
      err: text;
      ok: text;
    });
  confirmRecurringGroup: (groupId: text) -> (variant {
                                               err: text;
                                               ok;
                                             });
  confirmRecurringOccurrence: (bookingId: nat) -> (variant {
                                                     err: text;
                                                     ok;
                                                   });
  confirmStripeCheckoutSession: (sessionId: text) ->
   (variant {
      err: text;
      ok: text;
    });
  /// Create an ad hoc job record for a non-app client.
  /// CRITICAL: clientEmail and clientPhone are always empty — the non-app client
  /// is never contacted by the app under any circumstances.
  /// offAppClientAcknowledged MUST be true — sitter affirms the client has no Pawspect relationship.
  createAdHocJob: (sitterId: nat, clientName: text, adHocClientContact:
   opt text, "service": text, jobDate: text, startTime: text, endTime: 
   text, ratePerHourCents: nat, totalAmountCents: nat, coSitterId: opt nat,
   teamId: opt text, petNames: vec text, notes: opt text,
   offAppClientAcknowledged: bool) -> (variant {
                                         err: text;
                                         ok: Public__8;
                                       });
  createBooking: (input: Creation__3) -> (Public__8);
  createBookingWithCoupon: (input: Creation__3, couponCode: opt text) ->
   (Public__8);
  createCheckoutSession: (items: vec ShoppingItem, successUrl: text,
   cancelUrl: text) -> (text);
  createDealOffer: (sitterId: nat, discountType: DiscountType, discountValue:
   float64, description: text, expirationDate: int, clientEmails: vec text,
   maxUses: opt nat) -> (variant {
                           err: text;
                           ok: DealOffer;
                         });
  createJobThread: (teamId: text, bookingId: nat) ->
   (variant {
      err: text;
      ok: JobThread;
    });
  createNotification: (recipientSitterId: nat, title: text, body: text,
   notificationType: text) -> (NotificationRecord);
  createPayment: (input: Creation__2) -> (Public__6);
  createRecurringBookingGroup: (input: RecurringGroupCreation) ->
   (variant {
      err: text;
      ok: BookingGroup;
    });
  createSitterProfile: (input: Creation__1) -> (Public);
  /// Create a proper subscription checkout session using the configured Stripe Price ID.
  /// This is what the sitter portal "Subscribe Now" button should call.
  createSubscriptionCheckoutSession: (successUrl: text, cancelUrl: text) ->
   (text);
  createTeamInvite: (toSitterId: nat, proposedName: text, splitPercentages:
   vec record {
         nat;
         nat;
       }) -> (variant {
                err: text;
                ok: TeamInvite;
              });
  declineBookingRequest: (bookingId: Id, declineReason: text,
   alternativeWindows: vec AlternativeWindow) -> (variant {
                                                    err: text;
                                                    ok;
                                                  });
  declineRecurringOccurrence: (bookingId: nat, reason: text, alternatives:
   vec record {
         date: text;
         duration: text;
         time: text;
       }) -> (variant {
                err: text;
                ok;
              });
  deleteBooking: (bookingId: Id) -> (variant {
                                       err: text;
                                       ok;
                                     });
  deletePayment: (bookingId: Id) -> (variant {
                                       err: text;
                                       ok;
