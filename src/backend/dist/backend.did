service : {
  _initializeAccessControlWithSecret: (userSecret: text) -> ();
  acceptInviteByCode: (inviteCode: text) -> (variant {
                                               err: text;
                                               ok: Team;
                                             });
  addMessage: (bookingId: Id, senderName: text, content: text) -> ();
  addPhotoConsentLog: (sitterId: nat, photoUrl: text, consent1: bool,
   consent2: bool, consent3: bool) -> (variant {
                                         err: text;
                                         ok;
                                       });
  adjustPaymentPrice: (bookingId: Id, newAmount: nat, reason: text) ->
   (variant {
      err: text;
      ok;
    });
  adminAnonymizeSitter: (sitterId: Id) -> (variant {
                                             err: text;
                                             ok;
                                           });
  adminExportSitterData: (sitterId: Id) -> (variant {
